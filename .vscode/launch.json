{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Default (F5): starts the REPL without prompting for arguments.
            "name": "Fabric CLI Debug (Interactive)",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "fabric_cli.main",
            "cwd": "${workspaceFolder}/src",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [],
            // Interactive mode needs a TTY; the Debug Console does not provide one.
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            // Prompts for arguments, e.g. "ls /" or "--version".
            // Leave the prompt empty to start the REPL instead.
            "name": "Fabric CLI Debug (Prompt for args)",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "fabric_cli.main",
            "cwd": "${workspaceFolder}/src",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": "${command:pickArgs}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}